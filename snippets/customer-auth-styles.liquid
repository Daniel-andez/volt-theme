{% comment %}
  snippets/customer-auth-styles.liquid
  Shared CSS for login / register / reset / activate pages.
  Render once per auth page: {% render 'customer-auth-styles' %}
{% endcomment %}

<style>
  .customer-auth-page {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--volt-space-xl) var(--volt-container-pad, 1.25rem);
    background: var(--volt-surface);
  }
  .customer-auth-box {
    background: var(--volt-bg);
    border-radius: var(--volt-radius-lg);
    box-shadow: var(--volt-shadow-md);
    padding: var(--volt-space-3xl);
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: var(--volt-space-md);
  }
  .customer-auth-box__logo {
    display: block;
    text-align: center;
    font-size: 1.375rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-bottom: var(--volt-space-sm);
  }
  .customer-auth-box__logo img { margin: 0 auto; }
  .customer-auth-box__title {
    font-size: 1.625rem;
    font-weight: 800;
    text-align: center;
    letter-spacing: -0.03em;
    margin-bottom: var(--volt-space-sm);
  }
  .customer-auth-box__switch {
    text-align: center;
    font-size: .875rem;
    color: var(--volt-text-secondary);
    margin-top: var(--volt-space-sm);
  }
  .customer-auth-box__back {
    display: block;
    text-align: center;
    font-size: .8125rem;
    color: var(--volt-text-secondary);
    transition: color var(--volt-duration);
  }
  .customer-auth-box__back:hover { color: var(--volt-text); }

  /* Password input with toggle */
  .password-input-wrap { position: relative; }
  .password-input-wrap .form-input { padding-right: 2.75rem; }
  .password-toggle {
    position: absolute;
    right: .75rem;
    top: 50%;
    transform: translateY(-50%);
    opacity: .45;
    transition: opacity var(--volt-duration);
    display: flex;
    align-items: center;
  }
  .password-toggle:hover { opacity: 1; }

  /* Form link */
  .form-link {
    color: var(--volt-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity var(--volt-duration);
  }
  .form-link:hover { opacity: .7; }

  /* Form error banner */
  .form-error {
    background: color-mix(in srgb, var(--volt-error) 10%, transparent);
    border: 1.5px solid var(--volt-error);
    border-radius: var(--volt-radius-sm);
    padding: .75rem 1rem;
    font-size: .875rem;
    color: var(--volt-error);
  }
  .form-error ul { list-style: disc; padding-left: 1.25em; margin: 0; }

  /* Form success banner */
  .form-success {
    background: color-mix(in srgb, var(--volt-success) 10%, transparent);
    border: 1.5px solid var(--volt-success);
    border-radius: var(--volt-radius-sm);
    padding: .75rem 1rem;
    font-size: .875rem;
    color: var(--volt-success);
  }

  @media (max-width: 479px) {
    .customer-auth-box { padding: var(--volt-space-xl) var(--volt-space-lg); }
  }
</style>

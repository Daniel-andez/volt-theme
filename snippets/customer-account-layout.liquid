{% comment %}
  snippets/customer-account-layout.liquid
  ─────────────────────────────────────────────────────────────────────────────
  Shared wrapper for all authenticated customer pages.
  Usage:
    {% capture account_content %}…page content…{% endcapture %}
    {% render 'customer-account-layout', content: account_content, active: 'orders' %}

  Parameters:
    content   {String}  — captured HTML for the main panel
    active    {String}  — 'orders' | 'addresses' | 'details'
  ─────────────────────────────────────────────────────────────────────────────
{% endcomment %}

<div class="container section--sm">
  <div class="account-layout">

    {%- comment -%} ── Sidebar ── {%- endcomment -%}
    <aside class="account-sidebar">
      <div class="account-sidebar__avatar" aria-hidden="true">
        {{ customer.first_name | slice: 0 | upcase }}
      </div>
      <p class="account-sidebar__name">{{ customer.first_name }} {{ customer.last_name }}</p>
      <p class="account-sidebar__email">{{ customer.email }}</p>

      <nav class="account-nav" aria-label="{{ 'customer.account.nav_label' | t }}">
        <a
          href="{{ routes.account_url }}"
          class="account-nav__link{% if active == 'orders' %} is-active{% endif %}"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <rect x="2" y="3" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5 7h8M5 10h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {{ 'customer.account.orders' | t }}
        </a>
        <a
          href="{{ routes.account_addresses_url }}"
          class="account-nav__link{% if active == 'addresses' %} is-active{% endif %}"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 1.5C6.515 1.5 4.5 3.515 4.5 6c0 3.75 4.5 10.5 4.5 10.5S13.5 9.75 13.5 6c0-2.485-2.015-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="9" cy="6" r="1.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          {{ 'customer.account.addresses' | t }}
        </a>
        <a
          href="{{ routes.account_url }}/edit"
          class="account-nav__link{% if active == 'details' %} is-active{% endif %}"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <circle cx="9" cy="6" r="3" stroke="currentColor" stroke-width="1.5"/>
            <path d="M2.5 15.5c0-3.314 2.91-6 6.5-6s6.5 2.686 6.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {{ 'customer.account.details' | t }}
        </a>
      </nav>

      <a href="{{ routes.account_logout_url }}" class="account-sidebar__logout">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 2H3a1 1 0 00-1 1v10a1 1 0 001 1h3M11 11l3-3-3-3M14 8H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {{ 'customer.account.logout' | t }}
      </a>
    </aside>

    {%- comment -%} ── Main panel ── {%- endcomment -%}
    <main class="account-main" id="main-content" role="main" tabindex="-1">
      {{ content }}
    </main>

  </div>
</div>

<style>
  /* ── Account Layout ── */
  .account-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--volt-space-2xl);
    align-items: start;
  }

  /* Sidebar */
  .account-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    background: var(--volt-bg);
    border: 1.5px solid var(--volt-border);
    border-radius: var(--volt-radius-lg);
    padding: var(--volt-space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--volt-space-sm);
  }
  .account-sidebar__avatar {
    width: 56px; height: 56px;
    background: var(--volt-accent);
    color: var(--volt-accent-text);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.375rem;
    font-weight: 900;
    margin-bottom: var(--volt-space-xs);
  }
  .account-sidebar__name  { font-weight: 700; font-size: 1rem; }
  .account-sidebar__email { font-size: .8125rem; color: var(--volt-text-secondary); }

  /* Sidebar nav */
  .account-nav {
    width: 100%;
    margin-top: var(--volt-space-md);
    display: flex;
    flex-direction: column;
    gap: .25rem;
  }
  .account-nav__link {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .65rem .9rem;
    border-radius: var(--volt-radius-sm);
    font-size: .9rem;
    font-weight: 500;
    color: var(--volt-text-secondary);
    transition: background var(--volt-duration) var(--volt-ease),
                color     var(--volt-duration) var(--volt-ease);
  }
  .account-nav__link:hover,
  .account-nav__link.is-active {
    background: var(--volt-surface);
    color: var(--volt-text);
  }
  .account-nav__link.is-active { font-weight: 700; }
  .account-nav__link svg { flex-shrink: 0; }

  .account-sidebar__logout {
    display: flex;
    align-items: center;
    gap: .45rem;
    font-size: .8125rem;
    color: var(--volt-text-secondary);
    margin-top: var(--volt-space-md);
    transition: color var(--volt-duration);
  }
  .account-sidebar__logout:hover { color: var(--volt-error); }

  /* Main panel */
  .account-main { min-width: 0; }

  .account-section-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: var(--volt-space-xl);
    padding-bottom: var(--volt-space-md);
    border-bottom: 2px solid var(--volt-border);
  }

  /* Responsive */
  @media (max-width: 767px) {
    .account-layout {
      grid-template-columns: 1fr;
    }
    .account-sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      text-align: left;
      gap: var(--volt-space-md);
    }
    .account-sidebar__avatar { width: 44px; height: 44px; font-size: 1.1rem; }
    .account-nav { flex-direction: row; flex-wrap: wrap; }
    .account-nav__link { padding: .5rem .75rem; font-size: .8125rem; }
  }
</style>

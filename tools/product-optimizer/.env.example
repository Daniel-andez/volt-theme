# Shopify Admin API
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# Para generar el token con "npm run token" (solo se necesita una vez)
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: modelo Claude a usar (default: claude-opus-4-8)
# CLAUDE_MODEL=claude-sonnet-4-6

# Opcional: productos a procesar (IDs separados por coma, vacío = todos)
# TARGET_PRODUCT_IDS=gid://shopify/Product/123,gid://shopify/Product/456

# Opcional: handles a procesar (separados por coma)
# TARGET_HANDLES=camisa-blanca,pantalon-negro

# Marca (configura esto para cada tienda diferente)
BRAND_NAME=ANARIAS Atelier
BRAND_SLUG=anarias-atelier
# BRAND_VOICE=una marca de moda femenina premium colombiana

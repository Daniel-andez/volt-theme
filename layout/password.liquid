<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#FFD600">
    <title>{{ shop.name }} — Coming soon</title>

    {% render 'head-variables' %}
    {{ 'volt-theme.css' | asset_url | stylesheet_tag: preload: true }}

    {{ content_for_header }}
  </head>

  <body style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--volt-bg);">
    {{ content_for_layout }}
  </body>
</html>

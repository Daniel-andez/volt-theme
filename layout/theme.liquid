<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  class="no-js{% if settings.i18n_rtl_support %} rtl{% endif %}"
  data-cart-type="{{ settings.cart_type }}"
  data-animations="{{ settings.layout_animations_enabled }}"
>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="{{ settings.color_header_bg }}">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <!-- Canonical & pagination -->
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if paginate.previous.url -%}
    <link rel="prev" href="{{ paginate.previous.url }}">
  {%- endif -%}
  {%- if paginate.next.url -%}
    <link rel="next" href="{{ paginate.next.url }}">
  {%- endif -%}

  <!-- Shopify required hook -->
  {{ content_for_header }}

  <!-- Design tokens: CSS custom properties from theme settings -->
  {% render 'head-variables' %}

  <!-- Critical CSS (inline, zero render-blocking) -->
  <style id="zap-critical">
    /* ─── Reset ─────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }
    img, video { max-width: 100%; display: block; }
    a { color: inherit; }
    button { cursor: pointer; border: none; background: none; padding: 0; font: inherit; }

    /* ─── Utility: visually hidden ──────────────────────── */
    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    /* ─── Page wrapper ──────────────────────────────────── */
    .page-container {
      max-width: var(--zap-page-width);
      margin-inline: auto;
      padding-inline: clamp(1rem, 4vw, 2.5rem);
    }

    /* ─── Skip link ─────────────────────────────────────── */
    .skip-link {
      position: absolute; top: -100%; left: 1rem;
      background: var(--zap-accent); color: var(--zap-text);
      padding: 0.5rem 1rem; z-index: 9999; border-radius: 0 0 var(--zap-radius) var(--zap-radius);
      font-weight: 700; text-decoration: none;
      transition: top var(--zap-duration) var(--zap-ease);
    }
    .skip-link:focus { top: 0; }

    /* ─── Header clearance when sticky ─────────────────── */
    body.header-is-sticky main { padding-top: var(--header-height, 64px); }

    /* ─── Overlay shared by cart drawer & popup ─────────── */
    .zap-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 900;
      opacity: 0; pointer-events: none;
      transition: opacity var(--zap-duration-slow) var(--zap-ease);
    }
    .zap-overlay.is-active { opacity: 1; pointer-events: auto; }

    /* ─── Cart Drawer ───────────────────────────────────── */
    .cart-drawer {
      position: fixed; top: 0; right: 0;
      width: min(420px, 100vw);
      height: 100%;
      background: var(--zap-bg);
      box-shadow: -4px 0 24px rgba(0,0,0,0.12);
      z-index: 901;
      display: flex; flex-direction: column;
      transform: translateX(100%);
      transition: transform var(--zap-duration-slow) var(--zap-ease);
    }
    .cart-drawer.is-open { transform: translateX(0); }

    .cart-drawer__header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--zap-border);
      font-weight: 700; font-size: 1.125rem;
    }
    .cart-drawer__body  { flex: 1; overflow-y: auto; padding: 1.25rem 1.5rem; }
    .cart-drawer__footer {
      padding: 1.25rem 1.5rem;
      border-top: 1px solid var(--zap-border);
    }

    /* ─── Promo Popup ───────────────────────────────────── */
    .promo-popup {
      position: fixed; inset: 0;
      display: flex; align-items: center; justify-content: center;
      z-index: 950;
      padding: 1rem;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--zap-duration-slow) var(--zap-ease);
    }
    .promo-popup.is-active { opacity: 1; pointer-events: auto; }
    .promo-popup__inner {
      position: relative;
      background: var(--zap-bg);
      border-radius: var(--zap-radius);
      max-width: 560px; width: 100%;
      box-shadow: 0 24px 80px rgba(0,0,0,0.2);
      overflow: hidden;
    }

    /* ─── Age Verifier ──────────────────────────────────── */
    .age-verifier {
      position: fixed; inset: 0;
      background: var(--zap-bg);
      z-index: 9999;
      display: flex; align-items: center; justify-content: center;
    }
    .age-verifier.is-hidden { display: none; }
  </style>

  <!-- Theme stylesheet (non-blocking via preload) -->
  <link rel="preload" href="{{ 'zap-theme.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="{{ 'zap-theme.css' | asset_url }}"></noscript>

  <!-- Preconnect to Shopify CDN for faster font/image delivery -->
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
</head>

<body
  class="template-{{ request.page_type }}{% if settings.header_sticky %} header-is-sticky{% endif %}"
  data-section-id="body"
>

  <!-- Skip navigation for accessibility -->
  <a href="#main-content" class="skip-link">{{ 'accessibility.skip_to_content' | t | default: 'Skip to content' }}</a>

  <!-- ─── Age Verifier (renders before everything if enabled) ─── -->
  {%- if settings.age_verifier_enabled -%}
    <div
      class="age-verifier"
      id="age-verifier"
      role="dialog"
      aria-modal="true"
      aria-label="Age verification"
      data-minimum-age="{{ settings.age_verifier_minimum }}"
    >
      <div class="age-verifier__inner">
        {%- if sections['age-verifier'] -%}
          {%- section 'age-verifier' -%}
        {%- else -%}
          <!-- Fallback inline verifier -->
          <h2>You must be {{ settings.age_verifier_minimum }}+ to enter</h2>
          <div style="display:flex;gap:1rem;margin-top:1.5rem">
            <button
              class="btn btn--primary"
              onclick="window.__zap.ageVerifier.accept()"
            >I am {{ settings.age_verifier_minimum }}+</button>
            <button
              class="btn btn--secondary"
              onclick="history.back()"
            >Exit</button>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <!-- ─── Site Header ──────────────────────────────────────────── -->
  {%- section 'header' -%}

  <!-- ─── Promo Popup ──────────────────────────────────────────── -->
  {%- if settings.promo_popup_enabled -%}
    <div
      class="promo-popup"
      id="promo-popup"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.promo_popup.title' | t | default: 'Promotion' }}"
      data-delay="{{ settings.promo_popup_delay | times: 1000 }}"
    >
      <div class="zap-overlay" data-close-popup aria-hidden="true"></div>
      <div class="promo-popup__inner">
        {%- if sections['promo-popup'] -%}
          {%- section 'promo-popup' -%}
        {%- endif -%}
        <button
          class="promo-popup__close"
          aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
          data-close-popup
        >
          <!-- SVG close icon -->
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  {%- endif -%}

  <!-- ─── Cart Drawer (active when cart_type = "drawer") ───────── -->
  {%- if settings.cart_type == 'drawer' -%}
    <div class="zap-overlay" id="cart-overlay" aria-hidden="true"></div>
    <div
      class="cart-drawer"
      id="cart-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t | default: 'Your cart' }}"
    >
      <div class="cart-drawer__header">
        <span>{{ 'sections.cart.title' | t | default: 'Your cart' }}</span>
        <button
          class="cart-drawer__close"
          aria-label="{{ 'accessibility.close' | t | default: 'Close cart' }}"
          data-close-cart
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <!-- Cart content injected via JS -->
      <div class="cart-drawer__body" id="cart-drawer-items">
        <div class="cart-drawer__loading" aria-live="polite">
          <!-- Skeleton loader or spinner rendered here by cart.js -->
        </div>
      </div>

      <div class="cart-drawer__footer">
        {%- if settings.cart_notes_enabled -%}
          <div class="cart-note">
            <label for="cart-note" style="font-size:0.875rem;font-weight:600;display:block;margin-bottom:0.375rem">
              {{ 'sections.cart.note' | t | default: 'Order note' }}
            </label>
            <textarea
              id="cart-note"
              name="note"
              rows="2"
              placeholder="{{ 'sections.cart.note_placeholder' | t | default: 'Add a note to your order…' }}"
              style="width:100%;resize:vertical;padding:0.625rem;border:1px solid var(--zap-border);border-radius:var(--zap-radius);font:inherit;"
            ></textarea>
          </div>
        {%- endif -%}

        <div class="cart-drawer__subtotal" style="display:flex;justify-content:space-between;font-weight:700;margin:1rem 0" aria-live="polite">
          <span>{{ 'sections.cart.subtotal' | t | default: 'Subtotal' }}</span>
          <span id="cart-subtotal">—</span>
        </div>

        <button
          type="button"
          class="btn btn--primary btn--full"
          id="cart-checkout-btn"
          onclick="window.location='/checkout'"
        >
          {{ 'sections.cart.checkout' | t | default: 'Checkout' }}
        </button>

        <a
          href="/cart"
          class="btn btn--secondary btn--full"
          style="margin-top:0.625rem;display:block;text-align:center"
        >
          {{ 'sections.cart.view_cart' | t | default: 'View cart' }}
        </a>
      </div>
    </div>
  {%- endif -%}

  <!-- ─── Main content ─────────────────────────────────────────── -->
  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- ─── Site Footer ──────────────────────────────────────────── -->
  {%- section 'footer' -%}

  <!-- ─── Back to top ──────────────────────────────────────────── -->
  {%- if settings.nav_back_to_top -%}
    <button
      class="back-to-top"
      id="back-to-top"
      aria-label="{{ 'accessibility.back_to_top' | t | default: 'Back to top' }}"
      hidden
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M9 14V4M4 9l5-5 5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  {%- endif -%}

  <!-- ─── Theme JS (deferred — never blocks render) ────────────── -->
  <script>
    /* Inline: kill no-js class immediately */
    document.documentElement.classList.replace('no-js', 'js');
  </script>

  <script src="{{ 'zap-theme.js' | asset_url }}" defer></script>

  <!-- Shopify-required scripts (analytics, etc.) -->
  {% if content_for_header contains 'shopify' %}
    {% render 'shopify-scripts' %}
  {% endif %}

</body>
</html>

{% comment %}
  sections/main-customers-activate.liquid
  Activate an invited customer account. Uses {% form 'activate_customer_password' %}.
{% endcomment %}

<div class="customer-auth-page">
  <div class="customer-auth-box">

    <a href="{{ routes.root_url }}" class="customer-auth-box__logo">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 160 | image_tag: alt: shop.name, width: 120 }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <h1 class="customer-auth-box__title">{{ 'customer.activate.title' | t }}</h1>
    <p style="text-align:center; color:var(--volt-text-secondary); font-size:.9375rem; margin-top:-.5rem;">
      {{ 'customer.activate.subtitle' | t }}
    </p>

    {%- if form.errors -%}
      <div class="form-error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    {%- form 'activate_customer_password' -%}
      <div class="form-group">
        <label class="form-label" for="ActivatePassword">{{ 'customer.activate.password' | t }}</label>
        <div class="password-input-wrap">
          <input
            type="password"
            id="ActivatePassword"
            name="customer[password]"
            class="form-input"
            autocomplete="new-password"
            minlength="5"
            required
          >
          <button
            type="button"
            class="password-toggle"
            aria-label="{{ 'customer.login.show_password' | t }}"
            onclick="var i=document.getElementById('ActivatePassword'); i.type=i.type==='password'?'text':'password';"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M1 9s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6z" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="ActivatePasswordConfirm">{{ 'customer.activate.password_confirm' | t }}</label>
        <input
          type="password"
          id="ActivatePasswordConfirm"
          name="customer[password_confirmation]"
          class="form-input"
          autocomplete="new-password"
          minlength="5"
          required
        >
      </div>

      <button type="submit" class="btn btn--primary btn--full btn--lg">
        {{ 'customer.activate.submit' | t }}
      </button>
    {%- endform -%}

  </div>
</div>

{% render 'customer-auth-styles' %}

{% schema %}
{
  "name": "Activate account",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Activate account" }]
}
{% endschema %}

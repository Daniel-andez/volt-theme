{% comment %}
  sections/main-customers-reset-password.liquid
  Two states:
    1. Request reset email (form 'recover_customer_password')
    2. Set new password via token (form 'reset_customer_password')
{% endcomment %}

<div class="customer-auth-page">
  <div class="customer-auth-box">

    <a href="{{ routes.root_url }}" class="customer-auth-box__logo">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 160 | image_tag: alt: shop.name, width: 120 }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    {%- if form.posted_successfully? -%}
      {%- comment -%} Step 1 success — email sent {%- endcomment -%}
      <h1 class="customer-auth-box__title">{{ 'customer.recover_password.success_title' | t }}</h1>
      <div class="form-success" role="status">{{ 'customer.recover_password.success_message' | t }}</div>
      <a href="{{ routes.account_login_url }}" class="btn btn--secondary btn--full">
        ← {{ 'customer.recover_password.back_to_login' | t }}
      </a>

    {%- else -%}
      <h1 class="customer-auth-box__title">{{ 'customer.recover_password.title' | t }}</h1>
      <p style="text-align:center; color:var(--volt-text-secondary); font-size:.9375rem; margin-top:-.5rem;">
        {{ 'customer.recover_password.subtitle' | t }}
      </p>

      {%- if form.errors -%}
        <div class="form-error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      {%- form 'recover_customer_password' -%}
        <div class="form-group">
          <label class="form-label" for="RecoverEmail">{{ 'customer.recover_password.email' | t }}</label>
          <input
            type="email"
            id="RecoverEmail"
            name="email"
            class="form-input"
            autocomplete="email"
            autocapitalize="off"
            required
          >
        </div>
        <button type="submit" class="btn btn--primary btn--full btn--lg">
          {{ 'customer.recover_password.submit' | t }}
        </button>
      {%- endform -%}

      <p class="customer-auth-box__switch">
        <a href="{{ routes.account_login_url }}" class="form-link">
          ← {{ 'customer.recover_password.back_to_login' | t }}
        </a>
      </p>
    {%- endif -%}

  </div>
</div>

{% render 'customer-auth-styles' %}

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Reset password" }]
}
{% endschema %}

{%- comment -%}
  sections/porto-gallery.liquid
  Editorial render gallery with click-to-zoom lightbox (JS-enhanced).
{%- endcomment -%}

{%- render 'porto-assets' -%}

{%- assign s = section.settings -%}

<section class="porto porto-section porto-section--{{ s.background | default: 'ivory' }}">
  <div class="porto__wrap">
    <div class="porto-head {% if s.center_head %}porto-head--center{% endif %}" data-reveal>
      {%- if s.eyebrow != blank -%}<span class="porto-overline">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="porto-display porto-head__title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="porto-lead">{{ s.subheading }}</p>{%- endif -%}
    </div>

    <div class="porto-gallery__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign size = block.settings.size | default: 'md'
          assign alt = block.settings.caption | default: 'Render Porto Sabbia'
        -%}
        {%- if block.settings.image != blank -%}
          <figure class="porto-gallery__item porto-gallery__item--{{ size }}"
            data-reveal data-reveal-delay="{{ forloop.index0 | times: 70 }}"
            data-full="{{ block.settings.image | image_url: width: 2000 }}"
            data-alt="{{ alt | escape }}" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 1200 | image_tag:
              alt: alt | escape, loading: 'lazy',
              sizes: '(max-width: 720px) 50vw, 50vw', widths: '500, 800, 1200' }}
          </figure>
        {%- else -%}
          <figure class="porto-gallery__item porto-gallery__item--{{ size }}">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Porto · Galería",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "background", "label": "Fondo", "options": [
      { "value": "ivory", "label": "Marfil" },
      { "value": "cream", "label": "Crema" },
      { "value": "dark", "label": "Navy oscuro" }
    ], "default": "ivory" },
    { "type": "checkbox", "id": "center_head", "label": "Centrar encabezado", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Galería" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Imagina tu vida frente al mar" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Renders y espacios de Porto Sabbia. Toca cualquier imagen para verla en grande." }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Imagen",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "caption", "label": "Descripción (alt)", "default": "Render Porto Sabbia" },
        { "type": "select", "id": "size", "label": "Tamaño en mosaico", "options": [
          { "value": "lg", "label": "Grande (destacada)" },
          { "value": "md", "label": "Mediana" },
          { "value": "sm", "label": "Pequeña" }
        ], "default": "md" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Porto · Galería",
      "blocks": [
        { "type": "image", "settings": { "size": "lg" } },
        { "type": "image", "settings": { "size": "md" } },
        { "type": "image", "settings": { "size": "sm" } },
        { "type": "image", "settings": { "size": "sm" } },
        { "type": "image", "settings": { "size": "md" } },
        { "type": "image", "settings": { "size": "md" } }
      ]
    }
  ]
}
{% endschema %}

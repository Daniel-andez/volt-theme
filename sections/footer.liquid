{% comment %}
  sections/footer.liquid
  ─────────────────────────────────────────────────────────────────────────────
  OS 2.0 footer with: newsletter, social links, navigation columns,
  payment icons, locale/currency selectors, copyright.
  ─────────────────────────────────────────────────────────────────────────────
{% endcomment %}

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">

      {%- comment -%} ── Brand column ── {%- endcomment -%}
      <div class="footer-brand">
        {%- if section.settings.logo != blank -%}
          <a href="{{ routes.root_url }}" class="footer-brand__logo" aria-label="{{ shop.name }}">
            {{
              section.settings.logo
              | image_url: width: 180
              | image_tag:
                alt: shop.name,
                width: 120,
                loading: 'lazy',
                style: 'filter:brightness(0) invert(1);'
            }}
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="footer-brand__logo">{{ shop.name }}</a>
        {%- endif -%}

        {%- if section.settings.brand_description != blank -%}
          <p class="footer-brand__desc">{{ section.settings.brand_description }}</p>
        {%- endif -%}

        {%- comment -%} Social icons {%- endcomment -%}
        <div class="footer-socials">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9a8.18 8.18 0 004.79 1.54V7.09a4.85 4.85 0 01-1.02-.4z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="X / Twitter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 001.46 6.42 29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.96A29 29 0 0023 12a29 29 0 00-.46-5.58z" stroke="currentColor" stroke-width="1.8"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.236 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.181-.78 1.172-4.97 1.172-4.97s-.299-.598-.299-1.482c0-1.388.806-2.428 1.808-2.428.853 0 1.267.641 1.267 1.408 0 .858-.546 2.141-.828 3.33-.236.995.499 1.806 1.476 1.806 1.772 0 3.136-1.867 3.136-4.563 0-2.386-1.715-4.052-4.163-4.052-2.836 0-4.5 2.126-4.5 4.325 0 .856.33 1.774.741 2.276a.3.3 0 01.069.284c-.076.315-.244.995-.277 1.134-.045.183-.149.222-.343.134-1.249-.581-2.03-2.407-2.03-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.473 6.165 5.776 0 3.447-2.173 6.22-5.19 6.22-1.013 0-1.966-.527-2.292-1.148l-.623 2.378c-.226.869-.835 1.958-1.244 2.621.937.29 1.931.446 2.962.446 5.522 0 10-4.477 10-10S17.522 2 12 2z" fill="currentColor"/></svg>
            </a>
          {%- endif -%}
        </div>

        {%- comment -%} Newsletter {%- endcomment -%}
        {%- if section.settings.show_newsletter -%}
          <div class="footer-newsletter" style="margin-top:1.5rem;">
            <span class="footer-newsletter__label">{{ section.settings.newsletter_label | default: 'Subscribe to our newsletter' }}</span>
            {%- form 'customer', id: 'footer-newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="footer-newsletter__form">
                <input
                  type="email"
                  name="contact[email]"
                  class="footer-newsletter__input"
                  placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
                  required
                  autocomplete="email"
                  aria-label="{{ 'general.newsletter.email_placeholder' | t }}"
                >
                <button type="submit" class="footer-newsletter__btn">
                  {{ 'general.newsletter.submit' | t | default: 'Subscribe' }}
                </button>
              </div>
              {%- if form.posted_successfully? -%}
                <p style="color:var(--zap-accent);font-size:.875rem;margin-top:.5rem;">{{ 'general.newsletter.success' | t }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ── Nav columns (blocks) ── {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_column' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer-col__title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              {%- assign footer_menu = linklists[block.settings.menu] -%}
              <nav aria-label="{{ block.settings.heading | escape }}">
                {%- for link in footer_menu.links -%}
                  <a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a>
                {%- endfor -%}
              </nav>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>{%- comment -%} /.footer-grid {%- endcomment -%}

    {%- comment -%} ── Bottom bar ── {%- endcomment -%}
    <div class="footer-bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.copyright' | t }}</p>

      {%- comment -%} Locale / currency selectors {%- endcomment -%}
      <div style="display:flex; gap:1rem; align-items:center;">
        {%- if section.settings.show_locale_selector and shop.published_locales.size > 1 -%}
          {%- form 'localization', id: 'footer-locale-form' -%}
            <select name="locale_code" class="locale-select" onchange="this.form.submit();" aria-label="{{ 'general.locale_selector.label' | t }}" style="background:transparent; border:none; color:inherit; font-size:.8125rem; cursor:pointer; opacity:.6;">
              {%- for locale in shop.published_locales -%}
                <option value="{{ locale.iso_code }}" {% if locale.iso_code == request.locale.iso_code %}selected{% endif %}>
                  {{ locale.endonym_name | capitalize }}
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.show_currency_selector and shop.enabled_currencies.size > 1 -%}
          {%- form 'localization', id: 'footer-currency-form' -%}
            <select name="currency_code" class="currency-select" onchange="this.form.submit();" aria-label="{{ 'general.currency_selector.label' | t }}" style="background:transparent; border:none; color:inherit; font-size:.8125rem; cursor:pointer; opacity:.6;">
              {%- for currency in shop.enabled_currencies -%}
                <option value="{{ currency.iso_code }}" {% if currency == cart.currency %}selected{% endif %}>
                  {{ currency.iso_code }} {{ currency.symbol }}
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}
      </div>

      {%- comment -%} Payment icons {%- endcomment -%}
      {%- if section.settings.show_payment_icons -%}
        <div class="footer-payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'footer-payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "site-footer-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (white version)"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Premium products for modern living."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_label",
      "label": "Newsletter label",
      "default": "Stay in the loop"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_currency_selector",
      "label": "Show currency selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "nav_column",
      "name": "Navigation column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Navigation menu",
          "default": "footer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "nav_column", "settings": { "heading": "Shop" } },
      { "type": "nav_column", "settings": { "heading": "Help" } },
      { "type": "nav_column", "settings": { "heading": "Company" } }
    ]
  },
  "presets": [{ "name": "Footer" }],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}

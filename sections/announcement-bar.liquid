{% comment %}
  sections/announcement-bar.liquid
  Scrolling or static bar above the header. Supports multiple messages + dismiss.
{% endcomment %}

{%- assign messages = section.blocks | where: 'type', 'message' -%}

{%- if section.settings.show_bar and messages.size > 0 -%}
  <div
    class="announcement-bar"
    id="announcement-bar"
    style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};"
    role="region"
    aria-label="{{ 'sections.announcement_bar.label' | t }}"
  >
    <div class="announcement-bar__inner">
      {%- if messages.size == 1 -%}
        {%- assign msg = messages[0] -%}
        {%- if msg.settings.link != blank -%}
          <a href="{{ msg.settings.link }}" style="color:inherit;">{{ msg.settings.text }}</a>
        {%- else -%}
          <span>{{ msg.settings.text }}</span>
        {%- endif -%}
      {%- else -%}
        <div class="announcement-bar__ticker" id="announcement-ticker">
          {%- for block in messages -%}
            <span
              class="announcement-bar__msg{% if forloop.first %} is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" style="color:inherit;">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.dismissible -%}
        <button
          class="announcement-bar__close"
          data-dismiss-announcement
          aria-label="{{ 'general.accessibility.close' | t }}"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- if messages.size > 1 -%}
    <style>
      .announcement-bar__ticker { position: relative; overflow: hidden; }
      .announcement-bar__msg   { display: none; }
      .announcement-bar__msg.is-active { display: inline; }
    </style>
    <script>
      (function() {
        var msgs  = document.querySelectorAll('.announcement-bar__msg');
        var idx   = 0;
        if (msgs.length < 2) return;
        setInterval(function() {
          msgs[idx].classList.remove('is-active');
          idx = (idx + 1) % msgs.length;
          msgs[idx].classList.add('is-active');
        }, {{ section.settings.rotation_speed | default: 4 | times: 1000 }});
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "announcement-bar-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Allow dismissal",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Message rotation (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "🚀 Free shipping on orders over $50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "🚀 Free shipping on orders over $50" } },
      { "type": "message", "settings": { "text": "⚡ New arrivals every week" } }
    ]
  },
  "presets": [{ "name": "Announcement bar" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}

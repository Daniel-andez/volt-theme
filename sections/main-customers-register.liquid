{% comment %}
  sections/main-customers-register.liquid
  New account registration. Shopify handles via {% form 'create_customer' %}.
{% endcomment %}

<div class="customer-auth-page">
  <div class="customer-auth-box">

    <a href="{{ routes.root_url }}" class="customer-auth-box__logo">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 160 | image_tag: alt: shop.name, width: 120 }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <h1 class="customer-auth-box__title">{{ 'customer.register.title' | t }}</h1>

    {%- if form.errors -%}
      <div class="form-error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    {%- form 'create_customer' -%}

      <div class="grid-2" style="gap:var(--volt-space-md);">
        <div class="form-group">
          <label class="form-label" for="FirstName">{{ 'customer.register.first_name' | t }}</label>
          <input
            type="text"
            id="FirstName"
            name="customer[first_name]"
            class="form-input"
            autocomplete="given-name"
            {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
          >
        </div>
        <div class="form-group">
          <label class="form-label" for="LastName">{{ 'customer.register.last_name' | t }}</label>
          <input
            type="text"
            id="LastName"
            name="customer[last_name]"
            class="form-input"
            autocomplete="family-name"
            {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
          >
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
        <input
          type="email"
          id="RegisterEmail"
          name="customer[email]"
          class="form-input"
          autocomplete="email"
          autocapitalize="off"
          required
          {% if form.email %}value="{{ form.email }}"{% endif %}
        >
      </div>

      <div class="form-group">
        <label class="form-label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
        <div class="password-input-wrap">
          <input
            type="password"
            id="RegisterPassword"
            name="customer[password]"
            class="form-input"
            autocomplete="new-password"
            minlength="5"
            required
          >
          <button
            type="button"
            class="password-toggle"
            aria-label="{{ 'customer.login.show_password' | t }}"
            onclick="var i=document.getElementById('RegisterPassword'); i.type=i.type==='password'?'text':'password'; this.setAttribute('aria-pressed',i.type==='text');"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M1 9s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6z" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </button>
        </div>
        <p style="font-size:.75rem; color:var(--volt-text-secondary); margin-top:.3rem;">
          {{ 'customer.register.password_hint' | t }}
        </p>
      </div>

      <button type="submit" class="btn btn--primary btn--full btn--lg" style="margin-top:.25rem;">
        {{ 'customer.register.submit' | t }}
      </button>

    {%- endform -%}

    <p class="customer-auth-box__switch">
      {{ 'customer.register.have_account' | t }}
      <a href="{{ routes.account_login_url }}" class="form-link">{{ 'customer.register.login' | t }}</a>
    </p>

  </div>
</div>

{% render 'customer-auth-styles' %}

{% schema %}
{
  "name": "Register",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Register" }]
}
{% endschema %}

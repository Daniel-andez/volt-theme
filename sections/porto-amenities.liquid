{%- comment -%}
  sections/porto-amenities.liquid
  Resort-style amenities grid (dark, gold line icons).
{%- endcomment -%}

{%- render 'porto-assets' -%}

{%- assign s = section.settings -%}

<section class="porto porto-section porto-section--deep">
  <div class="porto__wrap">
    <div class="porto-head {% if s.center_head %}porto-head--center{% endif %}" data-reveal>
      {%- if s.eyebrow != blank -%}<span class="porto-overline">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="porto-display porto-head__title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="porto-lead">{{ s.subheading }}</p>{%- endif -%}
    </div>

    <div class="porto-amenities__grid">
      {%- for block in section.blocks -%}
        <div class="porto-amenity" data-reveal data-reveal-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
          <div class="porto-amenity__icon">{% render 'porto-icon', icon: block.settings.icon, size: 24 %}</div>
          <h3 class="porto-amenity__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="porto-amenity__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Porto · Amenidades",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "center_head", "label": "Centrar encabezado", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Estilo de vida resort" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Amenidades que se sienten como vacaciones eternas" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Cada detalle está pensado para disfrutar y para que tu propiedad rente mejor durante todo el año." }
  ],
  "blocks": [
    {
      "type": "amenity",
      "name": "Amenidad",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "options": [
          { "value": "beach", "label": "Beach club" },
          { "value": "pool", "label": "Piscina" },
          { "value": "wave", "label": "Mar / olas" },
          { "value": "sun", "label": "Solárium" },
          { "value": "gym", "label": "Gimnasio" },
          { "value": "spa", "label": "Spa / wellness" },
          { "value": "restaurant", "label": "Gastronomía" },
          { "value": "wifi", "label": "WiFi / smart" },
          { "value": "shield", "label": "Seguridad" },
          { "value": "concierge", "label": "Concierge" },
          { "value": "parking", "label": "Parqueadero" },
          { "value": "elevator", "label": "Ascensor" },
          { "value": "pet", "label": "Pet friendly" },
          { "value": "view", "label": "Vista al mar" }
        ], "default": "beach" },
        { "type": "text", "id": "title", "label": "Título", "default": "Beach club" },
        { "type": "textarea", "id": "text", "label": "Descripción", "default": "Acceso exclusivo para propietarios y huéspedes." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Porto · Amenidades",
      "blocks": [
        { "type": "amenity", "settings": { "icon": "beach", "title": "Beach club exclusivo", "text": "Club de playa privado para propietarios y huéspedes." } },
        { "type": "amenity", "settings": { "icon": "pool", "title": "Piscinas resort", "text": "Piscinas con vista al Caribe y zonas de descanso." } },
        { "type": "amenity", "settings": { "icon": "gym", "title": "Gimnasio equipado", "text": "Entrena frente al mar todos los días." } },
        { "type": "amenity", "settings": { "icon": "shield", "title": "Seguridad 24/7", "text": "Acceso controlado y vigilancia permanente." } },
        { "type": "amenity", "settings": { "icon": "restaurant", "title": "Gastronomía", "text": "Espacios sociales y propuesta gastronómica." } },
        { "type": "amenity", "settings": { "icon": "sun", "title": "Solárium", "text": "Terrazas y solárium para días de sol pleno." } },
        { "type": "amenity", "settings": { "icon": "concierge", "title": "Servicios hoteleros", "text": "Operación tipo hotel que potencia tu renta." } },
        { "type": "amenity", "settings": { "icon": "parking", "title": "Parqueaderos", "text": "Zonas de parqueo para residentes y visitantes." } }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  sections/porto-faq.liquid
  Accordion FAQ + FAQPage JSON-LD (rich results in Google).
{%- endcomment -%}

{%- render 'porto-assets' -%}

{%- assign s = section.settings -%}

<section class="porto porto-section porto-section--{{ s.background | default: 'cream' }}">
  <div class="porto__wrap porto__wrap--narrow">
    <div class="porto-head {% if s.center_head %}porto-head--center{% endif %}" data-reveal>
      {%- if s.eyebrow != blank -%}<span class="porto-overline">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="porto-display porto-head__title">{{ s.heading }}</h2>{%- endif -%}
    </div>

    <div class="porto-faq" data-reveal>
      {%- for block in section.blocks -%}
        <div class="porto-faq__item" {{ block.shopify_attributes }}>
          <button type="button" class="porto-faq__q" aria-expanded="false" id="faq-q-{{ block.id }}" aria-controls="faq-a-{{ block.id }}">
            {{ block.settings.question }}
            <span class="porto-faq__icon" aria-hidden="true"></span>
          </button>
          <div class="porto-faq__a" id="faq-a-{{ block.id }}" role="region" aria-labelledby="faq-q-{{ block.id }}">
            <div class="porto-faq__a-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if s.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | strip_html | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip_newlines | json }} }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Porto · FAQ",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "background", "label": "Fondo", "options": [
      { "value": "cream", "label": "Crema" },
      { "value": "ivory", "label": "Marfil" },
      { "value": "dark", "label": "Navy oscuro" }
    ], "default": "cream" },
    { "type": "checkbox", "id": "center_head", "label": "Centrar encabezado", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Resolvemos tus dudas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "checkbox", "id": "enable_schema", "label": "Activar datos estructurados FAQ (SEO)", "default": true }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Dónde está ubicado Porto Sabbia?" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>En la Bahía de Puerto Gaira, junto a Playa Salguero, Santa Marta. Una zona en plena renovación urbana y de alto potencial turístico.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Porto · FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "¿Dónde está ubicado Porto Sabbia?", "answer": "<p>En la Bahía de Puerto Gaira, junto a Playa Salguero, en Santa Marta. Una zona en plena renovación urbana y de alto potencial turístico.</p>" } },
        { "type": "faq", "settings": { "question": "¿Cuál es la diferencia entre Suites y Residences?", "answer": "<p>Las <strong>Suites</strong> son apartasuites compactas (34–54 m²) ideales para renta vacacional. Las <strong>Residences</strong> son apartamentos más amplios (51–133 m²) pensados para vivir o rentar a grupos grandes.</p>" } },
        { "type": "faq", "settings": { "question": "¿Desde qué precio puedo invertir?", "answer": "<p>Las Suites inician desde $485.000.000 COP y las Residences desde $638.000.000 COP. Consulta el plan de pagos vigente dejando tus datos.</p>" } },
        { "type": "faq", "settings": { "question": "¿Puedo rentar mi apartamento?", "answer": "<p>Sí. El proyecto está diseñado para renta vacacional de corta estancia, con beach club y amenidades tipo resort que aumentan la ocupación.</p>" } },
        { "type": "faq", "settings": { "question": "¿Cómo recibo más información?", "answer": "<p>Déjanos tus datos en el formulario o escríbenos por WhatsApp. Un asesor te enviará el brochure, precios y disponibilidad sin costo.</p>" } }
      ]
    }
  ]
}
{% endschema %}

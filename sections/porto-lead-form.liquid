{%- comment -%}
  sections/porto-lead-form.liquid
  Primary conversion section — captures qualified leads via Shopify contact form.
  Custom fields + UTM hidden inputs land in the store's contact notification email.
{%- endcomment -%}

{%- render 'porto-assets' -%}

{%- liquid
  assign s = section.settings
  assign benefits = s.benefits | newline_to_br | split: '<br />'
  assign wa_clean = s.whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
-%}

<section id="contacto" class="porto porto-section porto-section--ivory" data-porto-focus>
  <div class="porto__wrap">
    <div class="porto-lead-grid">

      {%- comment -%} ── Left: persuasion ── {%- endcomment -%}
      <div class="porto-lead-copy" data-reveal>
        {%- if s.eyebrow != blank -%}<span class="porto-overline">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="porto-display porto-lead-copy__title">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="porto-lead">{{ s.subheading }}</p>{%- endif -%}

        {%- if benefits.size > 0 -%}
          <div class="porto-lead-benefits">
            {%- for item in benefits -%}
              {%- assign parts = item | strip | split: '|' -%}
              {%- if parts.size > 0 and parts[0] != blank -%}
                <div class="porto-lead-benefit">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.5 6L8 14.5 4 10.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <div>
                    <strong>{{ parts[0] | strip }}</strong>
                    {%- if parts[1] != blank -%}<span>{{ parts[1] | strip }}</span>{%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if s.whatsapp != blank -%}
          <div style="margin-top:1.8rem;">
            <a href="https://wa.me/{{ wa_clean }}?text={{ s.whatsapp_text | default: 'Hola, quiero información de Porto Sabbia' | url_encode }}"
               class="porto-btn porto-btn--ghost" target="_blank" rel="noopener">
              {% render 'porto-icon', icon: 'whatsapp', size: 18 %} {{ s.whatsapp_label | default: 'Escríbenos por WhatsApp' }}
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ── Right: the form ── {%- endcomment -%}
      <div class="porto-form-card" data-reveal data-reveal-delay="120">
        {%- form 'contact', id: 'porto-lead', class: 'porto-lead-form', data-porto-form: 'lead' -%}
        {%- if form.posted_successfully? -%}
          <div class="porto-form-success" data-porto-form-status>
            <div class="porto-form-success__icon">
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M24 9L12 21l-6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3>{{ s.success_title | default: '¡Gracias! Recibimos tus datos' }}</h3>
            <p>{{ s.success_text | default: 'Un asesor de Porto Sabbia te contactará muy pronto con la información y disponibilidad.' }}</p>
          </div>
        {%- else -%}
          <h3 class="porto-form-card__title">{{ s.form_title | default: 'Recibe precios y disponibilidad' }}</h3>
          <p class="porto-form-card__sub">{{ s.form_sub | default: 'Déjanos tus datos y un asesor te enviará el brochure y el plan de pagos.' }}</p>

          {%- if form.errors -%}
            <div data-porto-form-status style="background:rgba(211,47,47,.12);color:#b71c1c;border-radius:6px;padding:.8rem 1rem;margin-bottom:1rem;font-size:.85rem;">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="porto-field">
              <label for="porto-name">Nombre completo *</label>
              <input type="text" id="porto-name" name="contact[name]" required autocomplete="name" placeholder="Tu nombre">
            </div>

            <div class="porto-field porto-field--row">
              <div>
                <label for="porto-phone">WhatsApp / Celular *</label>
                <input type="tel" id="porto-phone" name="contact[phone]" required autocomplete="tel" placeholder="+57 300 000 0000">
              </div>
              <div>
                <label for="porto-email">Email *</label>
                <input type="email" id="porto-email" name="contact[email]" required autocomplete="email" placeholder="tu@email.com">
              </div>
            </div>

            <div class="porto-field porto-field--row">
              <div>
                <label for="porto-proyecto">Proyecto de interés</label>
                <select id="porto-proyecto" name="contact[Proyecto de interes]">
                  <option value="Ambos">Ambos / Quiero asesoría</option>
                  <option value="Porto Sabbia Suites">Porto Sabbia Suites</option>
                  <option value="Porto Sabbia Residences">Porto Sabbia Residences</option>
                </select>
              </div>
              <div>
                <label for="porto-presupuesto">Presupuesto</label>
                <select id="porto-presupuesto" name="contact[Presupuesto]">
                  <option value="Por definir">Por definir</option>
                  <option value="$400M - $600M">$400M – $600M</option>
                  <option value="$600M - $900M">$600M – $900M</option>
                  <option value="$900M+">$900M+</option>
                </select>
              </div>
            </div>

            <div class="porto-field">
              <label for="porto-msg">Mensaje (opcional)</label>
              <textarea id="porto-msg" name="contact[body]" placeholder="Cuéntanos qué buscas: inversión, vivir, renta vacacional…"></textarea>
            </div>

            {%- comment -%} Hidden attribution fields (filled by JS) {%- endcomment -%}
            <input type="hidden" id="porto-utm-source" name="contact[utm_source]">
            <input type="hidden" id="porto-utm-medium" name="contact[utm_medium]">
            <input type="hidden" id="porto-utm-campaign" name="contact[utm_campaign]">
            <input type="hidden" id="porto-utm-term" name="contact[utm_term]">
            <input type="hidden" id="porto-utm-content" name="contact[utm_content]">
            <input type="hidden" id="porto-landing" name="contact[Landing]">
            <input type="hidden" id="porto-referrer" name="contact[Origen]">

            <label class="porto-consent">
              <input type="checkbox" name="contact[Acepta politica de datos]" value="Sí, acepto" required>
              <span>{{ s.consent_text | default: 'Autorizo el tratamiento de mis datos para ser contactado sobre este proyecto.' }}</span>
            </label>

            <button type="submit" class="porto-btn porto-btn--gold porto-btn--full porto-btn--lg">
              {{ s.submit_label | default: 'Quiero que me contacten' }}
            </button>

            <p class="porto-form-note">
              {% render 'porto-icon', icon: 'shield', size: 14 %} {{ s.privacy_note | default: 'Tus datos están seguros. Sin spam.' }}
            </p>
        {%- endif -%}
        {%- endform -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Porto · Contacto / Lead",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Texto persuasivo" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Da el primer paso" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Asegura tu unidad a precio de lanzamiento" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Cupos limitados en la primera etapa. Déjanos tus datos y recibe asesoría personalizada sin costo." },
    { "type": "textarea", "id": "benefits", "label": "Beneficios (Título | descripción, uno por línea)", "default": "Brochure y plan de pagos | Te lo enviamos al instante por WhatsApp\nPrecios de lanzamiento | Antes del próximo incremento\nAsesoría sin costo | Resolvemos todas tus dudas de inversión" },
    { "type": "header", "content": "WhatsApp" },
    { "type": "text", "id": "whatsapp", "label": "Número de WhatsApp (con indicativo)", "default": "+57 300 000 0000" },
    { "type": "text", "id": "whatsapp_label", "label": "Texto del botón", "default": "Escríbenos por WhatsApp" },
    { "type": "text", "id": "whatsapp_text", "label": "Mensaje prellenado", "default": "Hola, quiero información de Porto Sabbia" },
    { "type": "header", "content": "Formulario" },
    { "type": "text", "id": "form_title", "label": "Título del formulario", "default": "Recibe precios y disponibilidad" },
    { "type": "text", "id": "form_sub", "label": "Subtítulo del formulario", "default": "Déjanos tus datos y un asesor te enviará el brochure y el plan de pagos." },
    { "type": "text", "id": "submit_label", "label": "Texto del botón enviar", "default": "Quiero que me contacten" },
    { "type": "text", "id": "consent_text", "label": "Texto de consentimiento", "default": "Autorizo el tratamiento de mis datos para ser contactado sobre este proyecto." },
    { "type": "text", "id": "privacy_note", "label": "Nota de privacidad", "default": "Tus datos están seguros. Sin spam." },
    { "type": "header", "content": "Mensaje de éxito" },
    { "type": "text", "id": "success_title", "label": "Título de éxito", "default": "¡Gracias! Recibimos tus datos" },
    { "type": "textarea", "id": "success_text", "label": "Texto de éxito", "default": "Un asesor de Porto Sabbia te contactará muy pronto con la información y disponibilidad." }
  ],
  "presets": [{ "name": "Porto · Contacto / Lead" }]
}
{% endschema %}

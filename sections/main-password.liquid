{% comment %}sections/main-password.liquid — Coming soon / password page{% endcomment %}

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:2rem; background:var(--volt-bg);">
  <div style="max-width:480px; width:100%; text-align:center;">

    {%- if shop.password_message != blank -%}
      <p style="font-size:.9375rem; color:var(--volt-text-secondary); margin-bottom:var(--volt-space-xl);">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- if settings.logo -%}
      <a href="{{ routes.root_url }}" style="display:inline-block; margin-bottom:2rem;">
        {{ settings.logo | image_url: width: 200 | image_tag: alt: shop.name, width: 140 }}
      </a>
    {%- else -%}
      <a href="{{ routes.root_url }}" style="display:block; font-size:2rem; font-weight:900; letter-spacing:-0.04em; margin-bottom:2rem;">{{ shop.name }}</a>
    {%- endif -%}

    <h1 style="font-size:clamp(2rem,5vw,3rem); margin-bottom:1rem;">Coming soon</h1>
    <p style="color:var(--volt-text-secondary); margin-bottom:2rem;">{{ 'password.coming_soon_html' | t | default: "We're working on something great. Enter the password to get early access." }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p style="color:var(--volt-error); margin-bottom:.75rem; font-size:.875rem;">{{ 'password.wrong_password' | t | default: 'Wrong password. Try again.' }}</p>
      {%- endif -%}
      <div style="display:flex; gap:.5rem; max-width:380px; margin:0 auto 1.5rem;">
        <input
          type="password"
          name="password"
          id="Password"
          placeholder="{{ 'password.placeholder' | t | default: 'Enter password' }}"
          class="form-input"
          style="flex:1;"
          autocomplete="current-password"
          aria-label="{{ 'password.placeholder' | t | default: 'Enter password' }}"
          required
        >
        <button type="submit" class="btn btn--primary">{{ 'password.submit' | t | default: 'Enter' }}</button>
      </div>
    {%- endform -%}

    {%- if shop.owner_email -%}
      <p style="font-size:.8125rem; color:var(--volt-text-secondary);">
        {{ 'password.powered_by_shopify_html' | t }}
      </p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Password" }]
}
{% endschema %}

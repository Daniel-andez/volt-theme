{% comment %}
  sections/slideshow.liquid
  ─────────────────────────────────────────────────────────────────────────────
  Hero slideshow — full-width, touch-enabled, reduced-motion safe.
  Supports: text overlay, CTA buttons, image/video media, per-slide settings.
  ─────────────────────────────────────────────────────────────────────────────
{% endcomment %}

{%- liquid
  assign section_id  = 'slideshow-' | append: section.id
  assign slide_count = section.blocks | size
  assign autoplay    = section.settings.autoplay
  assign speed       = section.settings.autoplay_speed | times: 1000
  assign show_nav    = section.settings.show_arrows
  assign show_dots   = section.settings.show_dots
  assign full_height = section.settings.full_height
-%}

<section
  id="{{ section_id }}"
  class="slideshow{% if full_height %} slideshow--full{% endif %}{% if slide_count < 2 %} slideshow--single{% endif %}"
  data-autoplay="{{ autoplay }}"
  data-autoplay-speed="{{ speed }}"
  aria-label="{{ 'sections.slideshow.label' | t }}"
  aria-roledescription="carousel"
  tabindex="-1"
>

  {%- for block in section.blocks -%}
    {%- liquid
      assign is_active = false
      if forloop.first
        assign is_active = true
      endif

      assign text_color   = block.settings.text_color   | default: 'light'
      assign h_align      = block.settings.text_h_align | default: 'left'
      assign v_align      = block.settings.text_v_align | default: 'center'
      assign overlay_op   = block.settings.overlay_opacity | default: 30

      case h_align
        when 'left'   | assign align_items = 'flex-start'
        when 'center' | assign align_items = 'center'
        when 'right'  | assign align_items = 'flex-end'
      endcase

      case v_align
        when 'top'    | assign justify_content = 'flex-start'
        when 'center' | assign justify_content = 'center'
        when 'bottom' | assign justify_content = 'flex-end'
      endcase
    -%}

    <div
      class="slideshow__slide{% if is_active %} is-active{% endif %}"
      role="group"
      aria-roledescription="slide"
      aria-label="{{ forloop.index }} {{ 'sections.slideshow.of' | t }} {{ slide_count }}"
      {{ block.shopify_attributes }}
    >

      {%- comment -%} Media {%- endcomment -%}
      {%- if block.settings.video != blank -%}
        <video
          class="slideshow__media"
          autoplay muted loop playsinline
          aria-hidden="true"
          poster="{{ block.settings.image | image_url: width: 1920 }}"
        >
          <source src="{{ block.settings.video.sources[1].url }}" type="{{ block.settings.video.sources[1].mime_type }}">
        </video>
      {%- elsif block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1920
          | image_tag:
            class: 'slideshow__media',
            alt: block.settings.image.alt | escape,
            loading: forloop.first | ternary: 'eager', 'lazy',
            fetchpriority: forloop.first | ternary: 'high', 'auto',
            width: 1920,
            sizes: '100vw'
        }}
      {%- else -%}
        <div class="slideshow__media slideshow__media--placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg placeholder-svg--hero' }}
        </div>
      {%- endif -%}

      {%- comment -%} Colour overlay {%- endcomment -%}
      {%- if overlay_op > 0 -%}
        <div
          class="slideshow__overlay"
          style="background: {{ block.settings.overlay_color | default: '#000' }}; opacity: {{ overlay_op | divided_by: 100.0 }};"
          aria-hidden="true"
        ></div>
      {%- endif -%}

      {%- comment -%} Content {%- endcomment -%}
      {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.btn_label != blank -%}
        <div
          class="slideshow__content color-{{ text_color }}"
          style="--slide-h-align:{{ align_items }}; --slide-v-align:{{ justify_content }}; text-align:{{ h_align }};"
        >
          {%- if block.settings.eyebrow != blank -%}
            <span class="slideshow__eyebrow" data-animate="fade-up">{{ block.settings.eyebrow }}</span>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h2 class="slideshow__heading" data-animate="fade-up">{{ block.settings.heading }}</h2>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="slideshow__text" data-animate="fade-up">{{ block.settings.text }}</p>
          {%- endif -%}

          {%- if block.settings.btn_label != blank or block.settings.btn_2_label != blank -%}
            <div class="slideshow__btns" data-animate="fade-up">
              {%- if block.settings.btn_label != blank -%}
                <a
                  href="{{ block.settings.btn_url | default: '#' }}"
                  class="btn btn--{{ block.settings.btn_style | default: 'primary' }}"
                >
                  {{ block.settings.btn_label }}
                </a>
              {%- endif -%}
              {%- if block.settings.btn_2_label != blank -%}
                <a
                  href="{{ block.settings.btn_2_url | default: '#' }}"
                  class="btn btn--{{ block.settings.btn_2_style | default: 'secondary' }}"
                >
                  {{ block.settings.btn_2_label }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  {%- endfor -%}

  {%- if slide_count < 1 -%}
    {%- comment -%} Editor placeholder {%- endcomment -%}
    <div class="slideshow__slide is-active">
      <div class="slideshow__media slideshow__media--placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg placeholder-svg--hero' }}
      </div>
      <div class="slideshow__content" style="--slide-h-align:flex-start;--slide-v-align:center;">
        <h2 class="slideshow__heading">Your headline here</h2>
        <p class="slideshow__text">Add a slide via the theme editor.</p>
        <div class="slideshow__btns">
          <a href="#" class="btn btn--primary">Shop now</a>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Arrow navigation {%- endcomment -%}
  {%- if show_nav and slide_count > 1 -%}
    <button
      type="button"
      class="slideshow__nav slideshow__nav--prev"
      data-slide-prev
      aria-label="{{ 'sections.slideshow.previous_slide' | t }}"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M11 4L6 9L11 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button
      type="button"
      class="slideshow__nav slideshow__nav--next"
      data-slide-next
      aria-label="{{ 'sections.slideshow.next_slide' | t }}"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M7 4L12 9L7 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  {%- endif -%}

  {%- comment -%} Dot pagination {%- endcomment -%}
  {%- if show_dots and slide_count > 1 -%}
    <div class="slideshow__dots" role="tablist" aria-label="{{ 'sections.slideshow.dots_label' | t }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="slideshow__dot{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{{ forloop.first }}"
          aria-label="{{ 'sections.slideshow.go_to_slide' | t: num: forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "section-slideshow",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Full viewport height",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dot indicators",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (overrides image)"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay colour",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity (%)",
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 30
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow / kicker"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New collection"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button 1 label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button 1 link"
        },
        {
          "type": "select",
          "id": "btn_style",
          "label": "Button 1 style",
          "options": [
            { "value": "primary",   "label": "Primary (accent)" },
            { "value": "dark",      "label": "Dark" },
            { "value": "secondary", "label": "Outline" }
          ],
          "default": "primary"
        },
        {
          "type": "text",
          "id": "btn_2_label",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "btn_2_url",
          "label": "Button 2 link"
        },
        {
          "type": "select",
          "id": "btn_2_style",
          "label": "Button 2 style",
          "options": [
            { "value": "primary",   "label": "Primary (accent)" },
            { "value": "dark",      "label": "Dark" },
            { "value": "secondary", "label": "Outline" }
          ],
          "default": "secondary"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text colour",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark",  "label": "Dark" }
          ],
          "default": "light"
        },
        {
          "type": "select",
          "id": "text_h_align",
          "label": "Horizontal alignment",
          "options": [
            { "value": "left",   "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right",  "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "text_v_align",
          "label": "Vertical alignment",
          "options": [
            { "value": "top",    "label": "Top" },
            { "value": "center", "label": "Middle" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

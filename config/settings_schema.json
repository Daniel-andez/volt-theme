        "default": "3"
      },
      {
        "type": "select",
        "id": "collection_products_per_row_mobile",
        "label": "Products per Row (Mobile)",
        "options": [
          { "value": "1", "label": "1" },
          { "value": "2", "label": "2" }
        ],
        "default": "2"
      },
      {
        "type": "checkbox",
        "id": "collection_infinite_scroll",
        "label": "Enable Infinite Scroll",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "collection_filters_enabled",
        "label": "Enable Filters & Sort",
        "default": true

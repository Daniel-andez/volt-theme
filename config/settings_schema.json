  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "label": "Heading Scale (%)",
        "min": 75,
        "max": 150,
        "step": 5,
        "default": 100
      },
      {
        "type": "select",
        "id": "font_heading_weight",
        "label": "Heading Weight",
        "options": [
          { "value": "400", "label": "Regular" },
          { "value": "600", "label": "Semi Bold" },
          { "value": "700", "label": "Bold" },
          { "value": "800", "label": "Extra Bold" },
          { "value": "900", "label": "Black" }
        ],
        "default": "800"
      },
      {
        "type": "select",
        "id": "font_heading_transform",
        "label": "Heading Transform",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "uppercase", "label": "Uppercase" },
          { "value": "capitalize", "label": "Capitalize" }
        ],
        "default": "none"
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_body_size",
        "label": "Base Font Size (px)",
        "min": 12,
        "max": 20,
        "step": 1,
        "default": 16
      },
      {
        "type": "range",
        "id": "font_body_line_height",
        "label": "Body Line Height",
        "min": 1,
        "max": 2,
        "step": 0.1,
        "default": 1.6
      }
    ]
  },

  {
    "name": "Layout & Spacing",
    "settings": [
      {
        "type": "select",
        "id": "layout_page_width",
        "label": "Max Page Width",
        "options": [
          { "value": "1200px", "label": "Narrow (1200px)" },
          { "value": "1440px", "label": "Standard (1440px)" },
          { "value": "1600px", "label": "Wide (1600px)" },
          { "value": "100%",   "label": "Full Width" }
        ],
        "default": "1440px"
      },
      {
        "type": "range",
        "id": "layout_section_spacing",
        "label": "Section Vertical Spacing (px)",
        "min": 20,
        "max": 120,
        "step": 4,
        "default": 60
      },
      {
        "type": "range",
        "id": "layout_grid_gap",
        "label": "Grid Gap (px)",
        "min": 8,
        "max": 48,
        "step": 4,
        "default": 20
      },
      {
        "type": "range",
        "id": "layout_border_radius",
        "label": "Card Border Radius (px)",
        "min": 0,
        "max": 24,
        "step": 2,
        "default": 8
      },
      {
        "type": "checkbox",
        "id": "layout_animations_enabled",
        "label": "Enable UI Animations",
        "default": true
      }
    ]
  },

  {
    "name": "Header",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Enable Sticky Header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_transparent_home",
        "label": "Transparent Header on Homepage",
        "default": false
      },
      {
        "type": "select",
        "id": "header_logo_position",
        "label": "Logo Position",
        "options": [
          { "value": "left",   "label": "Left" },
          { "value": "center", "label": "Center" }
        ],
        "default": "left"
      },
      {
        "type": "range",
        "id": "header_logo_width",
        "label": "Logo Max Width (px)",
        "min": 60,
        "max": 300,
        "step": 10,
        "default": 140
      },
      {
        "type": "checkbox",
        "id": "header_mega_menu",
        "label": "Enable Mega Menu",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_search_enabled",
        "label": "Show Search Icon",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_account_enabled",
        "label": "Show Account Icon",
        "default": true
      }
    ]
  },

  {
    "name": "Cart & Checkout",
    "settings": [
      {
        "type": "header",
        "content": "Cart Type"
      },
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Style",
        "options": [
          { "value": "drawer",   "label": "Slide-out Drawer" },
          { "value": "page",     "label": "Cart Page" },
          { "value": "dropdown", "label": "Dropdown" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_notes_enabled",
        "label": "Enable Cart Notes",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_pickup_enabled",
        "label": "Enable In-Store Pickup",
        "default": false
      },
      {
        "type": "header",
        "content": "Quick Buy"
      },
      {
        "type": "checkbox",
        "id": "quick_buy_enabled",
        "label": "Enable Quick Buy",
        "default": true
      },
      {
        "type": "select",
        "id": "quick_buy_style",
        "label": "Quick Buy Style",
        "options": [
          { "value": "modal",  "label": "Modal Popup" },
          { "value": "inline", "label": "Inline (ATC)" }
        ],
        "default": "modal"
      }
    ]
  },

  {
    "name": "Product Pages",
    "settings": [
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "select",
        "id": "product_media_layout",
        "label": "Product Image Layout",
        "options": [
          { "value": "stacked",   "label": "Stacked" },
          { "value": "grid",      "label": "Grid" },
          { "value": "carousel",  "label": "Carousel" }
        ],
        "default": "stacked"
      },
      {
        "type": "checkbox",
        "id": "product_zoom_enabled",
        "label": "Enable Image Zoom",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_video_enabled",
        "label": "Enable Product Videos",
        "default": true

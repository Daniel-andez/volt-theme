      {
        "type": "header",
        "content": "Variants & Options"
      },
      {
        "type": "select",
        "id": "product_swatch_style",
        "label": "Color Swatch Style",
        "options": [
          { "value": "circle",    "label": "Circle" },
          { "value": "square",    "label": "Square" },
          { "value": "text",      "label": "Text Label" }
        ],
        "default": "circle"
      },
      {
        "type": "header",
        "content": "Conversion Features"
      },
      {
        "type": "checkbox",
        "id": "product_stock_counter",
        "label": "Show Stock Counter",
        "default": true
      },
      {
        "type": "range",
        "id": "product_stock_threshold",
        "label": "Low Stock Warning Threshold",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 5
      },
      {
        "type": "checkbox",
        "id": "product_trust_badges",
        "label": "Show Trust Badges",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_size_guide",
        "label": "Enable Size Guide",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_shipping_info",
        "label": "Show Shipping Info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_cross_sell",
        "label": "Enable Cross-Selling",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_recommended",
        "label": "Show Recommended Products",
        "default": true
      }
    ]
  },

  {
    "name": "Collections",
    "settings": [
      {
        "type": "select",
        "id": "collection_products_per_row_desktop",
